-    case 0x06A0: case 0x06A4: case 0x06A8: case 0x06AC:
-    case 0x06B0: case 0x06B4: case 0x06B8: case 0x06BC:
-        memcpy(&s_gpu.composite[(method - 0x0680) / 4], &param, 4);
-        s_gpu.composite_set = 1;
-        break;
-
