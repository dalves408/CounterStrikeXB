+/* Matrix and texgen methods address the same context memory that vertex
+ * programs read as constants. Keep one copy so uploads through either route
+ * also affect fixed-function transforms and lighting. */
+static int transform_context_method(uint32_t method, uint32_t param)
+{
+    uint32_t slot, word;
+
+    if (method >= 0x0440 && method < 0x0480) {
+        slot = 4u + (method - 0x0440u) / 16u;
+    } else if (method >= 0x0480 && method < 0x0680) {
+        word = (method - 0x0480u) / 4u;
+        slot = 8u + 8u * ((word / 16u) % 4u)
+                  + 4u * (word / 64u) + (word / 4u) % 4u;
+    } else if (method >= 0x0680 && method < 0x06C0) {
+        slot = (method - 0x0680u) / 16u;
+        s_gpu.composite_set = 1;
+    } else if (method >= 0x06C0 && method < 0x07C0) {
+        word = (method - 0x06C0u) / 4u;
+        slot = 68u + 8u * (word / 16u) + (word / 4u) % 4u;
+    } else if (method >= 0x0840 && method < 0x0940) {
+        word = (method - 0x0840u) / 4u;
+        slot = 64u + 8u * (word / 16u) + (word / 4u) % 4u;
+    } else {
+        return 0;
+    }
+    nv2a_vsh_constant_component(slot, (method / 4u) % 4u, param);
     return 1;
 }
 
