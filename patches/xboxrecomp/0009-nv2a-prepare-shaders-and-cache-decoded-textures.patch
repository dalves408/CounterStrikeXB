 static void put16(BYTE *p, UINT v) { p[0] = (BYTE)(v & 0xFF); p[1] = (BYTE)(v >> 8); }
 
+static void test_dxt_blocks(void)
+{
+    static const UINT32 rgb[4] = {0xFF0000, 0x0000FF, 0xAA0055, 0x5500AA};
+    static const UINT32 alpha[2][8] = {
+        {255, 0, 218, 182, 145, 109, 72, 36},
+        {0, 255, 51, 102, 153, 204, 0, 255}
+    };
+    BYTE block[16] = {0};
+    UINT32 pixels[16], fmt, pass, i;
+    for (fmt = 0x0C; fmt <= 0x0F; ++fmt) {
+        BYTE *color;
+        if (fmt == 0x0D) continue;
+        color = block + (fmt == 0x0C ? 0 : 8);
+        put16(color, 0xF800); put16(color + 2, 0x001F);
+        memset(color + 4, 0xE4, 4); /* All four color selectors, every row. */
+        for (pass = 0; pass < 2; ++pass) {
+            if (fmt == 0x0E) {
+                for (i = 0; i < 8; ++i) block[i] = (BYTE)((2 * i) | ((2 * i + 1) << 4));
+            } else if (fmt == 0x0F) {
+                uint64_t bits = 0;
+                block[0] = pass ? 0 : 255;
+                block[1] = pass ? 255 : 0;
+                for (i = 0; i < 16; ++i) bits |= (uint64_t)(i & 7) << (3 * i);
+                for (i = 0; i < 6; ++i) block[2 + i] = (BYTE)(bits >> (8 * i));
+            }
+            CHECK("decode entire DXT block", d3d8_dxt_decode_block(block, fmt, pixels));
+            for (i = 0; i < 16; ++i) {
+                UINT32 a = fmt == 0x0E ? i * 17 : (fmt == 0x0F ? alpha[pass][i & 7] : 255);
+                CHECK("DXT block pixel including alpha", pixels[i] == ((a << 24) | rgb[i & 3]));
+            }
+        }
+    }
+    memset(block, 0, sizeof block);
+    put16(block, 0x001F); put16(block + 2, 0xF800);
+    memset(block + 4, 0xE4, 4);
+    CHECK("DXT1 transparent block", d3d8_dxt_decode_block(block, 0x0C, pixels));
+    for (i = 0; i < 16; ++i) {
+        static const UINT32 colors[4] = {0xFF0000FF, 0xFFFF0000, 0xFF7F007F, 0};
+        CHECK("DXT1 three-color block pixel", pixels[i] == colors[i & 3]);
+    }
