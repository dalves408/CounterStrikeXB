From 1e6abc3ba3e8b310dfab7b167749e89f099695bc Mon Sep 17 00:00:00 2001
From: CounterStrikeXB2 <cs2@local>
Date: Thu, 12 Nov 2026 11:42:41 -0800
Subject: [PATCH] nv2a: prepare shaders and cache decoded textures

Prepare single-product combiner programs per batch with an interpreter fallback. Reuse byte-validated DXT image snapshots and shared block palettes, retain bounded block fallback, and reduce per-pixel scalar work without changing output arithmetic. Cover mappings, saturation, constants, alpha modes, texture rewrites, eviction, and format changes.

Co-authored-by: Copilot App <223556219+Copilot@users.noreply.github.com>
---
 src/d3d/d3d8_swizzle.h                       |  98 +++++------
 src/kernel/nv2a_combiner.c                   | 115 ++++++++++++-
 src/kernel/nv2a_combiner.h                   |  14 ++
 src/kernel/nv2a_pb_exec.c                    | 167 ++++++++++++++++---
 tests/d3d8_smoke/test_main.c                 |  43 +++++
 tests/nv2a_combiner/nv2a_combiner_test.c     | 142 ++++++++++++++++
 tests/nv2a_tex_filter/nv2a_tex_filter_test.c |  40 +++++
 7 files changed, 551 insertions(+), 68 deletions(-)

diff --git a/src/d3d/d3d8_swizzle.h b/src/d3d/d3d8_swizzle.h
index 281b4d2..04e1cfe 100644
--- a/src/d3d/d3d8_swizzle.h
+++ b/src/d3d/d3d8_swizzle.h
@@ -322,59 +322,37 @@ static inline uint32_t d3d8_format_dxt_block_bytes(uint32_t fmt)
     }
 }
 
-/**
- * Check if an Xbox D3D8 format is swizzled (vs linear/compressed).
- * Xbox formats with "LIN_" prefix are linear; DXT formats are block-compressed.
- * All other uncompressed formats are swizzled by default.
- */
-/* Decode one texel out of a DXT1/DXT3/DXT5 image.
- *
- * These are the only formats here that are neither linear nor swizzled: texels
- * live in 4x4 blocks, so there is no offset to compute and read -- the block
- * has to be decoded to get at one texel.
- *
- * ponytail: decodes the whole 4x4 block for every texel, so a filled triangle
- * decodes each block up to sixteen times. It is ~20 arithmetic ops on 16 bytes
- * that are already in L1 from the neighbouring texel, and the menu draws at
- * 640x480. Cache the last block by index if a textured 3D scene ever runs
- * through here.
- */
-static inline int d3d8_dxt_decode_texel(const uint8_t *base, uint32_t fmt,
-                                        uint32_t u, uint32_t v,
-                                        uint32_t width, uint32_t *argb)
+/* Decode a range within one block, sharing the colour/alpha palettes. A
+ * single-texel lookup need not expand all sixteen pixels, while a cache fill
+ * need not rebuild the same palettes sixteen times. */
+static inline int d3d8_dxt_decode_pixels(const uint8_t *block, uint32_t fmt,
+                                         uint32_t first, uint32_t count,
+                                         uint32_t *argb)
 {
     uint32_t block_bytes = d3d8_format_dxt_block_bytes(fmt);
-    uint32_t blocks_per_row = (width + 3u) / 4u;
-    const uint8_t *b;
-    uint32_t bx = u & 3u, by = v & 3u, texel = by * 4u + bx;
-    uint32_t c[4], idx, alpha = 255u;
-    uint32_t c0, c1, i;
+    const uint8_t *b = block;
+    uint32_t c[4] = {0}, alphas[8], indices;
+    uint32_t c0, c1, i, texel;
+    uint64_t alpha_bits = 0;
 
-    if (!block_bytes || !blocks_per_row)
+    if (!block_bytes || first >= 16 || count > 16 - first)
         return 0;
-    b = base + ((size_t)(v >> 2) * blocks_per_row + (u >> 2)) * block_bytes;
 
     /* Alpha comes first in DXT3 and DXT5; the colour block follows it. */
     if (block_bytes == 16) {
-        if (fmt == 0x0E) {                 /* DXT3: 4 bits per texel, packed */
-            uint32_t nib = b[texel >> 1];
-            alpha = d3d8_expand_channel((texel & 1u) ? (nib >> 4) : (nib & 0x0Fu), 4);
-        } else {                           /* DXT5: two endpoints + 3-bit index */
-            uint32_t a0 = b[0], a1 = b[1], a[8], sel;
-            uint64_t bits = 0;
+        if (fmt == 0x0F) {                 /* DXT5: two endpoints + 3-bit index */
+            uint32_t a0 = b[0], a1 = b[1];
             for (i = 0; i < 6; i++)
-                bits |= (uint64_t)b[2 + i] << (8 * i);
-            a[0] = a0; a[1] = a1;
+                alpha_bits |= (uint64_t)b[2 + i] << (8 * i);
+            alphas[0] = a0; alphas[1] = a1;
             if (a0 > a1)
                 for (i = 1; i < 7; i++)
-                    a[i + 1] = ((7 - i) * a0 + i * a1) / 7;
+                    alphas[i + 1] = ((7 - i) * a0 + i * a1) / 7;
             else {
                 for (i = 1; i < 5; i++)
-                    a[i + 1] = ((5 - i) * a0 + i * a1) / 5;
-                a[6] = 0; a[7] = 255;
+                    alphas[i + 1] = ((5 - i) * a0 + i * a1) / 5;
+                alphas[6] = 0; alphas[7] = 255;
             }
-            sel = (uint32_t)((bits >> (3 * texel)) & 7u);
-            alpha = a[sel];
         }
         b += 8;
     }
@@ -405,16 +383,42 @@ static inline int d3d8_dxt_decode_texel(const uint8_t *base, uint32_t fmt,
         c[3] = 0;                          /* transparent black */
     }
 
-    idx = ((uint32_t)b[4] | ((uint32_t)b[5] << 8)
-        | ((uint32_t)b[6] << 16) | ((uint32_t)b[7] << 24)) >> (2 * texel);
-    idx &= 3u;
-    if (block_bytes == 8 && c0 <= c1 && idx == 3)
-        alpha = 0;                         /* DXT1's one bit of alpha */
-
-    *argb = (alpha << 24) | (c[idx] & 0x00FFFFFFu);
+    indices = (uint32_t)b[4] | ((uint32_t)b[5] << 8)
+            | ((uint32_t)b[6] << 16) | ((uint32_t)b[7] << 24);
+    for (texel = first; texel < first + count; ++texel) {
+        uint32_t idx = (indices >> (2 * texel)) & 3u, alpha = 255;
+        if (fmt == 0x0E) {
+            uint32_t nib = block[texel >> 1];
+            alpha = ((texel & 1) ? nib >> 4 : nib & 15u) * 17u;
+        } else if (fmt == 0x0F) {
+            alpha = alphas[(alpha_bits >> (3 * texel)) & 7u];
+        } else if (c0 <= c1 && idx == 3) {
+            alpha = 0;
+        }
+        argb[texel - first] = (alpha << 24) | (c[idx] & 0x00FFFFFFu);
+    }
     return 1;
 }
 
+static inline int d3d8_dxt_decode_block(const uint8_t *block, uint32_t fmt,
+                                        uint32_t argb[16])
+{
+    return d3d8_dxt_decode_pixels(block, fmt, 0, 16, argb);
+}
+
+static inline int d3d8_dxt_decode_texel(const uint8_t *base, uint32_t fmt,
+                                        uint32_t u, uint32_t v,
+                                        uint32_t width, uint32_t *argb)
+{
+    uint32_t block_bytes = d3d8_format_dxt_block_bytes(fmt);
+    uint32_t blocks_per_row = (width + 3u) / 4u;
+    if (!block_bytes || !blocks_per_row)
+        return 0;
+    return d3d8_dxt_decode_pixels(
+        base + ((size_t)(v >> 2) * blocks_per_row + (u >> 2)) * block_bytes,
+        fmt, (v & 3u) * 4u + (u & 3u), 1, argb);
+}
+
 static inline int d3d8_format_is_swizzled(uint32_t fmt)
 {
     /* Linear formats (0x10-0x41 range excludes the non-LIN 0x19-0x3C range) */
diff --git a/src/kernel/nv2a_combiner.c b/src/kernel/nv2a_combiner.c
index 0113446..c02dfd8 100644
--- a/src/kernel/nv2a_combiner.c
+++ b/src/kernel/nv2a_combiner.c
@@ -10,6 +10,9 @@
 #include "nv2a_combiner.h"
 
 #include <string.h>
+#if defined(_M_X64) || defined(__SSE2__)
+#include <emmintrin.h>
+#endif
 
 /* The rasteriser evaluates pixels on several threads. */
 #if defined(_MSC_VER)
@@ -23,10 +26,18 @@ enum { R_ZERO = 0, R_C0 = 1, R_C1 = 2, R_FOG = 3, R_V0 = 4, R_V1 = 5,
 
 void nv2a_rc_unpack(uint32_t c, float o[4])
 {
+#if defined(_M_X64) || defined(__SSE2__)
+    __m128i bytes = _mm_cvtsi32_si128((int)c);
+    __m128i words = _mm_unpacklo_epi8(bytes, _mm_setzero_si128());
+    __m128i channels = _mm_unpacklo_epi16(words, _mm_setzero_si128());
+    channels = _mm_shuffle_epi32(channels, _MM_SHUFFLE(3, 0, 1, 2));
+    _mm_storeu_ps(o, _mm_div_ps(_mm_cvtepi32_ps(channels), _mm_set1_ps(255.0f)));
+#else
     o[0] = (float)((c >> 16) & 0xFF) / 255.0f;
     o[1] = (float)((c >>  8) & 0xFF) / 255.0f;
     o[2] = (float)( c        & 0xFF) / 255.0f;
     o[3] = (float)( c >> 24        ) / 255.0f;
+#endif
 }
 
 /* D3DCOLOR to floats, memoised: a program's constants are the same for
@@ -46,13 +57,13 @@ static const float *unpack_cached(uint32_t c)
     return val[slot];
 }
 
-static float clampf(float x, float lo, float hi)
+static inline float clampf(float x, float lo, float hi)
 {
     return x < lo ? lo : (x > hi ? hi : x);
 }
 
 /* PS_INPUTMAPPING, psh.c get_input_var. */
-static float map_in(float x, uint32_t byte)
+static inline float map_in(float x, uint32_t byte)
 {
     float p = x < 0.0f ? 0.0f : x;
     switch ((byte >> 5) & 7) {
@@ -94,6 +105,106 @@ static float read_alpha(float R[16][4], uint32_t byte)
     return map_in((byte & 0x10) ? r[3] : r[2], byte);
 }
 
+static int product_source(uint8_t byte)
+{
+    unsigned reg = byte & 15;
+    return reg <= R_V1 || (reg >= R_T0 && reg < R_R0);
+}
+
+void nv2a_rc_prepare(const Nv2aCombiner *rc, Nv2aCombinerProgram *p)
+{
+    unsigned i;
+    p->state = rc;
+    p->kind = 0;
+    if ((rc->control & 0xff) != 1 ||
+        (rc->color_ocw[0] != 0xC0 && rc->color_ocw[0] != 0xC00) ||
+        (rc->alpha_ocw[0] != 0xC0 && rc->alpha_ocw[0] != 0xC00) ||
+        (rc->color_icw[0] & 0xffff) || (rc->alpha_icw[0] & 0xffff))
+        return;
+    if (rc->final0 || rc->final1) {
+        if ((rc->final1 & 0xffffff00u) != 0x1C00 ||
+            (rc->final0 != R_R0 && rc->final0 != 0x010C0002))
+            return;
+    }
+    for (i = 0; i < 2; ++i) {
+        p->rgb[i] = (uint8_t)(rc->color_icw[0] >> (24 - i * 8));
+        p->alpha[i] = (uint8_t)(rc->alpha_icw[0] >> (24 - i * 8));
+        if (!product_source(p->rgb[i]) || !product_source(p->alpha[i]))
+            return;
+    }
+    nv2a_rc_unpack(rc->factor0[0], p->c0);
+    nv2a_rc_unpack(rc->factor1[0], p->c1);
+    p->kind = rc->final0 == 0x010C0002 ? 2 : 1;
+    if (p->kind == 2) {
+        nv2a_rc_unpack(rc->final_c0, p->scale);
+        nv2a_rc_unpack(rc->final_c1, p->bias);
+    }
+    if (p->kind == 1 && rc->color_icw[0] == 0x08200000 &&
+        rc->alpha_icw[0] == 0x14200000)
+        p->kind = 3;
+    else if (p->kind == 2 && rc->color_icw[0] == 0x08040000 &&
+             rc->alpha_icw[0] == 0x18140000)
+        p->kind = 4;
+}
+
+static inline const float *product_register(const Nv2aCombinerProgram *p,
+                                             uint8_t byte, const float v0[4],
+                                             const float v1[4], const float fog[4],
+                                             const float t[4][4])
+{
+    static const float zero[4] = {0};
+    switch (byte & 15) {
+    case R_C0: return p->c0;
+    case R_C1: return p->c1;
+    case R_FOG: return fog;
+    case R_V0: return v0;
+    case R_V1: return v1;
+    case 8: case 9: case 10: case 11: return t[(byte & 15) - R_T0];
+    default: return zero;
+    }
+}
+
+void nv2a_rc_eval_prepared(const Nv2aCombinerProgram *p, const float v0[4],
+                          const float v1[4], const float fog[4],
+                          const float t[4][4], float out[4])
+{
+    const float *a, *b, *aa, *ab;
+    unsigned i;
+    if (!p->kind) {
+        nv2a_rc_eval(p->state, v0, v1, fog, t, out);
+        return;
+    }
+    if (p->kind == 3) { /* texture RGB, diffuse alpha */
+        for (i = 0; i < 3; ++i)
+            out[i] = clampf(t[0][i], 0.0f, 1.0f);
+        out[3] = clampf(v0[3], 0.0f, 1.0f);
+        return;
+    }
+    if (p->kind == 4) { /* texture * diffuse, then the final constant transform */
+        for (i = 0; i < 3; ++i) {
+            float value = clampf(map_in(t[0][i], 0) * map_in(v0[i], 0), 0.0f, 1.0f);
+            out[i] = clampf(p->bias[i] + value * p->scale[i], 0.0f, 1.0f);
+        }
+        out[3] = clampf(map_in(t[0][3], 0) * map_in(v0[3], 0), 0.0f, 1.0f);
+        return;
+    }
+    a = product_register(p, p->rgb[0], v0, v1, fog, t);
+    b = product_register(p, p->rgb[1], v0, v1, fog, t);
+    aa = product_register(p, p->alpha[0], v0, v1, fog, t);
+    ab = product_register(p, p->alpha[1], v0, v1, fog, t);
+    /* CD is zero and only AB (or AB+CD) writes r0. The final stage either
+     * passes r0 through or computes c1 + c0*r0; both read unsigned r0. */
+    for (i = 0; i < 3; ++i) {
+        float value = clampf(map_in(a[(p->rgb[0] & 16) ? 3 : i], p->rgb[0]) *
+                             map_in(b[(p->rgb[1] & 16) ? 3 : i], p->rgb[1]),
+                             0.0f, 1.0f);
+        out[i] = p->kind == 2
+            ? clampf(p->bias[i] + value * p->scale[i], 0.0f, 1.0f) : value;
+    }
+    out[3] = clampf(map_in(aa[(p->alpha[0] & 16) ? 3 : 2], p->alpha[0]) *
+                    map_in(ab[(p->alpha[1] & 16) ? 3 : 2], p->alpha[1]), 0.0f, 1.0f);
+}
+
 void nv2a_rc_eval(const Nv2aCombiner *rc, const float v0[4],
                   const float v1[4], const float fog[4],
                   const float t[4][4], float out[4])
diff --git a/src/kernel/nv2a_combiner.h b/src/kernel/nv2a_combiner.h
index 8abfc5f..dfc9fce 100644
--- a/src/kernel/nv2a_combiner.h
+++ b/src/kernel/nv2a_combiner.h
@@ -35,6 +35,20 @@ void nv2a_rc_eval(const Nv2aCombiner *rc, const float v0[4],
                   const float v1[4], const float fog[4],
                   const float t[4][4], float out[4]);
 
+typedef struct {
+    const Nv2aCombiner *state;
+    unsigned kind;
+    uint8_t rgb[2], alpha[2];
+    float c0[4], c1[4], scale[4], bias[4];
+} Nv2aCombinerProgram;
+
+/* Prepare once per batch. The state must remain unchanged until all pixels
+ * finish; the prepared program is read-only and may be shared by workers. */
+void nv2a_rc_prepare(const Nv2aCombiner *rc, Nv2aCombinerProgram *program);
+void nv2a_rc_eval_prepared(const Nv2aCombinerProgram *program, const float v0[4],
+                          const float v1[4], const float fog[4],
+                          const float t[4][4], float out[4]);
+
 /* D3DCOLOR (0xAARRGGBB) to r,g,b,a floats. */
 void nv2a_rc_unpack(uint32_t argb, float out[4]);
 
diff --git a/src/kernel/nv2a_pb_exec.c b/src/kernel/nv2a_pb_exec.c
index 08006a7..1aec3a6 100644
--- a/src/kernel/nv2a_pb_exec.c
+++ b/src/kernel/nv2a_pb_exec.c
@@ -30,6 +30,9 @@
 #include <stdlib.h>
 #include <string.h>
 #include <time.h>
+#if defined(_M_X64) || defined(__SSE2__)
+#include <emmintrin.h>
+#endif
 #include "kernel.h"   /* XBOX_CONTIG_BASE / XBOX_CONTIG_SIZE */
 #include "xbox_memory_layout.h"   /* xbox_Nv2aFrameCounterFlip */
 #include "nv2a_flip_hold.h"
@@ -274,6 +277,8 @@ typedef struct {
     int      border_color;              /* FORMAT: BORDER reads `border` */
     int      cube;                      /* FORMAT: six faces, not one    */
     int      valid;
+    const uint32_t *decoded;            /* immutable for this draw batch */
+    uint32_t decoded_pitch;
 } Texture;
 
 static struct {
@@ -1143,6 +1148,8 @@ static uint32_t wrap_coord(uint32_t c, uint32_t size, uint32_t mode)
      * texel 0 is -1, which must wrap to the far edge or clamp to 0 -- as an
      * unsigned value it clamped to the far edge instead. */
     int32_t sc = (int32_t)c, n = (int32_t)size;
+    if (c < size)
+        return c;
     if (!size)
         return 0;
     if (mode == 1)                         /* wrap */
@@ -1181,6 +1188,97 @@ static uint32_t linear_twin(uint32_t fmt)
     }
 }
 
+/* Validate compressed images once per batch, not once per bilinear tap.
+ * Entries retain the source bytes, so in-place writes invalidate the image.
+ * The executor prepares all stages before releasing workers, and joins them
+ * before another draw can replace an entry. Larger images/cubemaps retain
+ * the bounded thread-local block cache below. */
+#define NV_DECODED_TEXTURES 8
+#define NV_DECODED_MAX_PIXELS (1024u * 1024u)
+static struct {
+    uint32_t offset, format, width, height;
+    uint64_t used;
+    size_t raw_capacity, pixel_capacity;
+    uint8_t *raw;
+    uint32_t *pixels;
+} s_decoded[NV_DECODED_TEXTURES];
+static uint64_t s_decoded_clock;
+
+static int combiners_enabled(void)
+{
+    static int disabled = -1;
+    if (disabled < 0)
+        disabled = getenv("RECOMP_NO_COMBINERS") != NULL;
+    return s_gpu.rc_seen && !disabled;
+}
+
+static void prepare_textures(uint32_t stages)
+{
+    const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset();
+    uint64_t batch = ++s_decoded_clock;
+    int st;
+    for (st = 0; st < 4; ++st) {
+        Texture *t = &s_gpu.texs[st];
+        uint32_t bb = d3d8_format_dxt_block_bytes(t->color), w, h, x, y;
+        size_t raw_size, pixel_size;
+        int i, slot = -1, same = 0;
+        t->decoded = NULL;
+        if (!(stages & (1u << st)) || !t->valid || !bb || t->cube)
+            continue;
+        w = (t->width + 3u) & ~3u; h = (t->height + 3u) & ~3u;
+        if (!w || !h || (uint64_t)w * h > NV_DECODED_MAX_PIXELS)
+            continue;
+        raw_size = (size_t)(w / 4) * (h / 4) * bb;
+        pixel_size = (size_t)w * h * sizeof(uint32_t);
+        if (!guest_span_ok(t->offset, (uint32_t)raw_size))
+            continue;
+        for (i = 0; i < NV_DECODED_TEXTURES; ++i) {
+            if (s_decoded[i].used && s_decoded[i].offset == t->offset &&
+                s_decoded[i].format == t->color && s_decoded[i].width == w &&
+                s_decoded[i].height == h) {
+                slot = i; same = 1; break;
+            }
+            /* Never evict a different texture prepared for this batch. */
+            if (s_decoded[i].used != batch &&
+                (slot < 0 || s_decoded[i].used < s_decoded[slot].used))
+                slot = i;
+        }
+        if (slot < 0)
+            continue;
+        if (s_decoded[slot].raw_capacity < raw_size) {
+            uint8_t *raw = (uint8_t *)realloc(s_decoded[slot].raw, raw_size);
+            if (!raw) {
+                fprintf(stderr, "[GPU] compressed texture source allocation failed (%zu bytes)\n", raw_size);
+                continue;
+            }
+            s_decoded[slot].raw = raw; s_decoded[slot].raw_capacity = raw_size;
+        }
+        if (s_decoded[slot].pixel_capacity < pixel_size) {
+            uint32_t *pixels = (uint32_t *)realloc(s_decoded[slot].pixels, pixel_size);
+            if (!pixels) {
+                fprintf(stderr, "[GPU] decoded texture allocation failed (%zu bytes)\n", pixel_size);
+                continue;
+            }
+            s_decoded[slot].pixels = pixels; s_decoded[slot].pixel_capacity = pixel_size;
+        }
+        if (!same || memcmp(s_decoded[slot].raw, mem + t->offset, raw_size)) {
+            memcpy(s_decoded[slot].raw, mem + t->offset, raw_size);
+            for (y = 0; y < h; y += 4)
+                for (x = 0; x < w; x += 4) {
+                    uint32_t block[16], row;
+                    const uint8_t *src = s_decoded[slot].raw + ((size_t)(y / 4) * (w / 4) + x / 4) * bb;
+                    d3d8_dxt_decode_block(src, t->color, block);
+                    for (row = 0; row < 4; ++row)
+                        memcpy(s_decoded[slot].pixels + (size_t)(y + row) * w + x, block + row * 4, 16);
+                }
+            s_decoded[slot].offset = t->offset; s_decoded[slot].format = t->color;
+            s_decoded[slot].width = w; s_decoded[slot].height = h;
+        }
+        s_decoded[slot].used = batch;
+        t->decoded = s_decoded[slot].pixels; t->decoded_pitch = w;
+    }
+}
+
 /* Sample texel (u, v) of stage texture `t`; `face` offsets a cube map. */
 static int sample_tex(const Texture *t, uint32_t face_offset,
                       uint32_t u, uint32_t v, uint32_t *argb)
@@ -1204,6 +1302,10 @@ static int sample_tex(const Texture *t, uint32_t face_offset,
     u = wrap_coord(u, t->width,  t->addr_u);
     v = wrap_coord(v, t->height, t->addr_v);
 
+    if (t->decoded) {
+        *argb = t->decoded[(size_t)v * t->decoded_pitch + u];
+        return 1;
+    }
     fmt = t->color;
     if (d3d8_format_dxt_block_bytes(fmt)) {
         /* Decoded blocks, direct-mapped by address. Every texel of a DXT
