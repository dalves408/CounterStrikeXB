From 95c1e5e51f78634c96ffe6f062184fbdf551ea96 Mon Sep 17 00:00:00 2001
From: CounterStrikeXB2 <cs2@local>
Date: Wed, 11 Nov 2026 06:00:00 -0800
Subject: [PATCH] kernel, nv2a: deliver D3D's software method 5; rescue a
 BlockOnTime the executor outran (CounterStrikeXB2 local patch)

XDK D3D's BlockOnTime clears a title-built event, rewrites a fence slot in the
pushbuffer to NO_OPERATION(5) and waits on the event with no timeout; the
GPU's PGRAPH interrupt for that software method runs D3D's handler
(CMiniport::ServiceGrInterrupt), which sets it. The executor treated every
software method as a no-op (only the swap's interval was used), and with the
segment scan's late GET it could already have passed the slot D3D rewrote.
Counter-Strike froze in a match whenever the host fell behind: every run on
WARP, about one in three on a laptop with the frame window throttled.

- nv2a_pb_exec: xbox_Nv2aRaiseSoftwareMethod raises the PGRAPH error
  interrupt as the console does (TRAPPED_ADDR/DATA, NSOURCE, PGRAPH_INTR,
  PMC_INTR_0), waits for the handler (PGRAPH_FIFO preset 2, the handler
  writes 1 on exit; 250 ms at most) and drops it. The walk raises the methods
  RECOMP_PB_SW_INTR selects (default 5 only: 8, 9 and 13 come several times a
  frame and cost 9.6 -> 80 ms frames delivered; "all", a hex mask, or 0).
- kernel_bridge: a new IRQ line (XBOX_IRQ_PGRAPH) raised on the timer thread
  at once, under the gate as the vblank is; xbox_memory_layout keeps the
  raiser's PGRAPH/PMC bits out of the ack pass while it is in flight.
- KeWaitForSingleObject on a title event with no timeout waits in 100 ms
  slices: the guest word set without KeSetEvent ends it; with the GPU idle
  (DMA PUT = GET, no flip held) for 100 ms, software method 5 is raised, as
  the GPU would have on passing D3D's slot (RECOMP_PB_SW_RESCUE=0: off); after
  5 s the stuck state is logged (PUT, GET, flip hold).
Measured: WARP 3/3 runs without a freeze (6/6 froze before); RTX 3070 match
frame times unchanged (median 9.2 ms, p99 11.3 vs 11.6 ms).
---
 src/kernel/kernel.h             |   1 +
 src/kernel/kernel_bridge.c      | 125 ++++++++++++++++++++++++++++++++
 src/kernel/kernel_hal.c         |   2 +-
 src/kernel/nv2a_pb_exec.c       |  97 ++++++++++++++++++++++++-
 src/kernel/xbox_memory_layout.c |  11 +++
 5 files changed, 233 insertions(+), 3 deletions(-)

diff --git a/src/kernel/kernel.h b/src/kernel/kernel.h
index 0030a67..033a385 100644
--- a/src/kernel/kernel.h
+++ b/src/kernel/kernel.h
@@ -908,6 +908,7 @@ enum {
     XBOX_IRQ_VBLANK,
     XBOX_IRQ_APU,
     XBOX_IRQ_OHCI,
+    XBOX_IRQ_PGRAPH,    /* a software method trapped to D3D's handler (nv2a_pb_exec.c) */
     XBOX_IRQ_LINES
 };
 /* What xbox_IrqPost tells the device model to do. */
diff --git a/src/kernel/kernel_bridge.c b/src/kernel/kernel_bridge.c
index 9476517..0e7bd22 100644
--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -2049,6 +2049,82 @@ static void bridge_KeWaitForSingleObject(void)
          * writing 0 there -- so bring the host event in line first. */
         int type;
         HANDLE ge = ke_guest_event_prepare(object, &type);
+        if (ge && !timeout_ptr) {
+            /* An infinite wait wakes every 250 ms and trusts the guest word. Code
+             * that sets SignalState without KeSetEvent (an interrupt routine
+             * writing it, say) never signals the host event, and the waiter
+             * slept for ever -- a match freezing, mostly when the host is slow.
+             * Each such catch is logged (the first 20), with the guest caller. */
+            DWORD r;
+            ULONGLONG t0 = GetTickCount64(), last_rescue = 0;
+            int stuck_logged = 0;
+            for (;;) {
+                r = WaitForSingleObjectEx(ge, 100, (BOOL)alertable);
+                if (r != WAIT_TIMEOUT)
+                    break;
+                {   /* XDK D3D's BlockOnTime sleeps on a title event that its
+                     * handler for software method 5 sets when the GPU reaches a
+                     * point in the pushbuffer. If the executor had already passed
+                     * that point when D3D chose it, nothing would ever raise the
+                     * method: with the GPU idle (everything submitted executed)
+                     * the point has been reached, so raise it now, as the GPU
+                     * would have -- D3D's own handler sets the event. At most
+                     * once a second per wait; RECOMP_PB_SW_RESCUE=0 turns it off. */
+                    extern volatile uint32_t *xbox_Nv2aRegPtr(uint32_t offset);
+                    extern int nv2a_pb_exec_flip_poll(void);
+                    extern int xbox_Nv2aRaiseSoftwareMethod(uint32_t param);
+                    static int rescue_on = -1;
+                    volatile uint32_t *put = xbox_Nv2aRegPtr(0x800040u), *get = xbox_Nv2aRegPtr(0x800044u);
+                    ULONGLONG now = GetTickCount64();
+                    if (rescue_on < 0) {
+                        const char *e = getenv("RECOMP_PB_SW_RESCUE");
+                        rescue_on = !(e && *e == '0');
+                    }
+                    if (rescue_on && put && get && *put == *get && now - t0 >= 100 && now - last_rescue >= 1000
+                            && BRIDGE_MEM32(object + 4) == 0 && !nv2a_pb_exec_flip_poll()) {
+                        static volatile LONG rescues;
+                        last_rescue = now;
+                        if (InterlockedIncrement(&rescues) <= 20)
+                            fprintf(stderr, "  [KEWAIT] guest event %08X: GPU idle (PUT=GET %08X) after %llu ms;"
+                                    " raising software method 5 (caller %08X)\n",
+                                    object, *get, now - t0, BRIDGE_MEM32(g_esp - 4));
+                        xbox_Nv2aRaiseSoftwareMethod(5u);
+                        continue;
+                    }
+                }
+                if (BRIDGE_MEM32(object + 4) != 0) {
+                    static volatile LONG caught;
+                    if (InterlockedIncrement(&caught) <= 20)
+                        fprintf(stderr, "  [KEWAIT] guest event %08X set without KeSetEvent; waiter woken after %llu ms"
+                                " (caller %08X)\n", object, GetTickCount64() - t0, BRIDGE_MEM32(g_esp - 4));
+                    r = WAIT_OBJECT_0;
+                    break;
+                }
+                if (!stuck_logged && GetTickCount64() - t0 > 5000) {
+                    extern volatile uint32_t *xbox_Nv2aRegPtr(uint32_t offset);
+                    extern int nv2a_pb_exec_flip_poll(void);
+                    volatile uint32_t *put = xbox_Nv2aRegPtr(0x800040u), *get = xbox_Nv2aRegPtr(0x800044u);
+                    stuck_logged = 1;
+                    fprintf(stderr, "  [KEWAIT] guest event %08X (type %d) still not set after 5 s (caller %08X);"
+                            " DMA PUT %08X GET %08X, flip held %d\n", object, type, BRIDGE_MEM32(g_esp - 4),
+                            put ? *put : 0, get ? *get : 0, nv2a_pb_exec_flip_poll());
+                    if (get) {   /* where D3D patched WAIT_FOR_IDLE + NO_OPERATION(5), if it did */
+                        uint32_t g = 0x80000000u | (*get & 0x0FFFFFFFu), a, lo = g - 0x100000u, hi = g + 0x100000u;
+                        int shown = 0;
+                        for (a = lo; a < hi && shown < 4; a += 4)
+                            if (BRIDGE_MEM32(a + 8) == 0x00040100u && BRIDGE_MEM32(a + 12) == 5u) {
+                                fprintf(stderr, "  [KEWAIT]   NO_OPERATION(5) patched at %08X (GET %+d bytes)\n",
+                                        a + 12, (int)(a + 12 - g));
+                                shown++;
+                            }
+                    }
+                }
+            }
+            g_eax = r == WAIT_OBJECT_0 ? 0u : (r == WAIT_IO_COMPLETION ? 0xC0u : 0xC0000001u);
+            if (g_eax == 0 && type == 1)               /* synchronization: consumed */
+                BRIDGE_MEM32(object + 4) = 0;
+            return;
+        }
         if (ge) {
             g_eax = (uint32_t)xbox_KeWaitForSingleObject(
                 ge, wait_reason, wait_mode,
@@ -3124,6 +3200,54 @@ static void kernel_vblank_deliver(void)
     }
 }
 
+/* A PGRAPH interrupt for a trapped software method (nv2a_pb_exec.c
+ * sw_method_interrupt), raised on the timer thread as soon as the executor
+ * asks rather than with the next vblank: D3D's handler for software method 9
+ * keeps its GPU-progress time, and method 5 ends a BlockOnTime. The PGRAPH and
+ * PMC_INTR_0 bits are the executor's; this only runs the ISR (which queues the
+ * DPC that services them) under the gate, as the vblank does. With the line
+ * masked (the ISR's DPC is pending), that DPC services PGRAPH when it runs. */
+static volatile LONG g_pgraph_pending;
+
+static void kernel_pgraph_deliver(void)
+{
+    (void)kernel_call_isr(NV2A_VECTOR);
+}
+
+void xbox_Nv2aPgraphInterrupt(void)
+{
+    InterlockedExchange(&g_pgraph_pending, 1);
+    xbox_HostTimerWake();
+}
+
+static void kernel_pgraph_raise(void)
+{
+    if (!InterlockedExchange(&g_pgraph_pending, 0))
+        return;
+    if (!xbox_GetConnectedInterrupt(NV2A_VECTOR))
+        return;
+    xbox_IrqSetHandler(XBOX_IRQ_PGRAPH, kernel_pgraph_deliver);
+    if (!InterlockedCompareExchange((volatile LONG *)&BRIDGE_MEM32(XBOX_NV2A_REG_BASE + NV2A_PMC_INTR_EN_0), 0, 0))
+        return;
+    switch (xbox_IrqSafePointsOn() ? xbox_IrqPost(XBOX_IRQ_PGRAPH) : XBOX_IRQ_UNGATED) {
+    case XBOX_IRQ_GATED:
+        kernel_pgraph_deliver();
+        xbox_DispatchGateLeave();
+        break;
+    case XBOX_IRQ_UNGATED: {
+        int gated = xbox_DispatchGateTryEnter();
+        if (!gated)
+            xbox_IrqNoteUngated(XBOX_IRQ_PGRAPH);
+        kernel_pgraph_deliver();
+        if (gated)
+            xbox_DispatchGateLeave();
+        break;
+    }
+    default:
+        break;                          /* the holder runs it */
+    }
+}
+
 /* The holder's run of a posted vblank: kernel_hal.c has put it on a worker
  * stack at the device IRQL. */
 static void kernel_vblank_on_holder(void)
@@ -3713,6 +3837,7 @@ static void kernel_timer_loop_ns(void)
          * drains at a raise runs now rather than at the next edge. */
         xbox_HostTimerSleepNs(wait);
         kernel_vblank_tick_ns(xbox_HostNowNs(), &vbl_next);
+        kernel_pgraph_raise();
         busy = kernel_drain_dpcs(&ran);   /* deferred work, before due timers */
         now_ms = kernel_timer_clock_ms();
         kernel_fire_timers(now_ms, &timer_due);
