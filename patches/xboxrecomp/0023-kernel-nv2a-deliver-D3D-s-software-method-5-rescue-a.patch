--- a/src/kernel/kernel_hal.c
+++ b/src/kernel/kernel_hal.c
@@ -350,7 +350,7 @@ static int s_dpc_on;            /* RECOMP_DPC_ON_RAISE, under the gate */
 static XBOX_THREAD_LOCAL int t_guest_thread;
 static XBOX_THREAD_LOCAL int t_in_dpc;
 static uint64_t s_irq_wait_ns;
-static const char *const s_irq_names[XBOX_IRQ_LINES] = { "vblank", "apu", "ohci" };
+static const char *const s_irq_names[XBOX_IRQ_LINES] = { "vblank", "apu", "ohci", "pgraph" };
 
 static struct {
     volatile LONG posted[XBOX_IRQ_LINES], on_holder[XBOX_IRQ_LINES],
diff --git a/src/kernel/nv2a_pb_exec.c b/src/kernel/nv2a_pb_exec.c
index a779870..92304bd 100644
--- a/src/kernel/nv2a_pb_exec.c
+++ b/src/kernel/nv2a_pb_exec.c
@@ -4640,6 +4640,97 @@ static int transform_context_method(uint32_t method, uint32_t param)
     return 1;
 }
 
+/* A D3D software method other than the swap: NO_OPERATION with a value, which
+ * the console's GPU traps to D3D's interrupt handler as a PGRAPH error
+ * interrupt with the method and value latched in TRAPPED_ADDR / TRAPPED_DATA,
+ * PGRAPH stalled until the handler has run (xemu does the same).
+ *
+ * XDK D3D uses one when it finds the GPU far behind: it clears an event,
+ * queues WAIT_FOR_IDLE and NO_OPERATION(5), kicks off, and waits on the event
+ * with no timeout -- the handler for software method 5 sets it. Treated as a
+ * no-op that wait never ended: Counter-Strike froze in a match whenever the
+ * host fell behind (a slow GPU, WARP, a throttled process).
+ *
+ * Raised for the vblank's ISR and DPC to find: D3D's DPC services PGRAPH
+ * whenever PGRAPH_INTR is non-zero, and its handler (CMiniport::
+ * ServiceGrInterrupt) writes PGRAPH_FIFO 0 on entry and 1 on exit. So
+ * PGRAPH_FIFO is preset to 2 and the walk waits here -- the stall -- until it
+ * reads 1, then drops the interrupt (the register is plain memory here, not
+ * write-1-to-clear). 250 ms without the handler: the interrupt is dropped
+ * anyway and the walk goes on, logged once. RECOMP_PB_SW_INTR=0: the old
+ * no-op. Returns 1 when it raised the interrupt. */
+int xbox_Nv2aRaiseSoftwareMethod(uint32_t param)
+{
+    static SRWLOCK lock = SRWLOCK_INIT;
+    extern volatile LONG g_nv2a_sw_intr_inflight;
+    static unsigned raised, timeouts;
+    volatile uint32_t *intr, *nsource, *taddr, *tdata, *fifo, *pmc;
+    LARGE_INTEGER f, t0, now;
+
+    intr = xbox_Nv2aRegPtr(0x400100);   nsource = xbox_Nv2aRegPtr(0x400108);
+    taddr = xbox_Nv2aRegPtr(0x400704);  tdata = xbox_Nv2aRegPtr(0x400708);
+    fifo = xbox_Nv2aRegPtr(0x400720);   pmc = xbox_Nv2aRegPtr(0x000100);
+    if (!intr || !nsource || !taddr || !tdata || !fifo || !pmc)
+        return 0;
+    AcquireSRWLockExclusive(&lock);      /* one trapped method at a time */
+    InterlockedIncrement(&g_nv2a_sw_intr_inflight);
+    *taddr = NV097_NO_OPERATION;        /* the method; subchannel and channel 0 */
+    *tdata = param;
+    *nsource = 1u;                      /* NSOURCE_NOTIFICATION */
+    *fifo = 2u;
+    InterlockedOr((volatile LONG *)intr, 0x00100000);   /* PGRAPH_INTR_ERROR */
+    InterlockedOr((volatile LONG *)pmc, 0x00001000);    /* PMC_INTR_0: PGRAPH */
+    raised++;
+    {   /* now, not at the next vblank (kernel_bridge.c) */
+        extern void xbox_Nv2aPgraphInterrupt(void);
+        xbox_Nv2aPgraphInterrupt();
+    }
+    QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&t0);
+    for (;;) {
+        if (*fifo == 1u)
+            break;
+        QueryPerformanceCounter(&now);
+        if ((now.QuadPart - t0.QuadPart) * 1000 / f.QuadPart >= 250) {
+            if (timeouts++ < 5)
+                fprintf(stderr, "  [NV2A] software method %u (0x%08X): no handler after 250 ms, dropped\n",
+                        param & 0x1Fu, param);
+            break;
+        }
+        Sleep(1);
+    }
+    InterlockedAnd((volatile LONG *)intr, ~0x00100000);
+    *nsource = 0;
+    InterlockedAnd((volatile LONG *)pmc, ~0x00001000);
+    InterlockedDecrement(&g_nv2a_sw_intr_inflight);
+    ReleaseSRWLockExclusive(&lock);
+    if (raised <= 3 || (raised & (raised - 1)) == 0)
+        fprintf(stderr, "  [NV2A] software method %u (0x%08X) raised (%u so far, %u unanswered)\n",
+                param & 0x1Fu, param, raised, timeouts);
+    return 1;
+}
+
+/* The executor's part: the methods RECOMP_PB_SW_INTR selects, when the walk
+ * reaches them. */
+static int sw_method_interrupt(uint32_t param)
+{
+    static int on = -1;
+    static uint32_t ids;                /* bit n: software method n is delivered */
+    if (on < 0) {
+        /* RECOMP_PB_SW_INTR: 0 none; "all"; or a hex mask of method numbers.
+         * Default: 5 only -- the one D3D sleeps on (BlockOnTime). Delivering
+         * every method (8, 9 and 13 come several times a frame) took a match
+         * from 9.6 ms frames to 80 ms; as no-ops they cost nothing visible. */
+        const char *e = getenv("RECOMP_PB_SW_INTR");
+        on = !(e && *e == '0');
+        ids = (e && !strcmp(e, "all")) ? 0xFFFFFFFFu
+            : (e && *e && *e != '0') ? (uint32_t)strtoul(e, NULL, 16) : (1u << 5);
+    }
+    if (!on || !(ids & (1u << (param & 0x1Fu))))
+        return 0;
+    return xbox_Nv2aRaiseSoftwareMethod(param);
+}
+
 void nv2a_pb_exec_method(uint32_t subch, uint32_t method, uint32_t param)
 {
     /* BACK_END_WRITE_SEMAPHORE_RELEASE. The title's pointer already names the
@@ -4930,8 +5021,10 @@ void nv2a_pb_exec_method(uint32_t subch, uint32_t method, uint32_t param)
         break;
     case NV097_NO_OPERATION:
         /* Non-zero, it is one of D3D's software methods, which the GPU traps
-         * to D3D's interrupt handler on the console. Only the swap's interval
-         * matters here (nv2a_flip_hold.h); the rest stays a no-op. */
+         * to D3D's interrupt handler on the console. The swap (method 1) is
+         * paced here (nv2a_flip_hold.h); the others go to the handler. */
+        if (param && (param & 0x1Fu) != 1u && sw_method_interrupt(param))
+            return;
         if (!nv2a_pb_exec_flip_pacing()) {
             if (!imm_vertex_method(method, param))
                 note_unhandled(method, param);   /* as before the hold */
diff --git a/src/kernel/xbox_memory_layout.c b/src/kernel/xbox_memory_layout.c
index 8bc848d..6aeedc3 100644
--- a/src/kernel/xbox_memory_layout.c
+++ b/src/kernel/xbox_memory_layout.c
@@ -1428,6 +1428,11 @@ static void framebuffer_probe_tick(void)
  * and a level load, thousands of kickoffs long, looked frozen. Clearing them
  * from inside the walk answers the kickoff within a few hundred commands,
  * without a thread of its own spinning on a host core. */
+/* A software-method interrupt being delivered (nv2a_pb_exec.c
+ * xbox_Nv2aRaiseSoftwareMethod): its PGRAPH_INTR and PMC_INTR_0 bits belong to
+ * the raiser until D3D's handler has run, as the vblank's do. */
+volatile LONG g_nv2a_sw_intr_inflight;
+
 static void nv2a_ack_busy_bits(int flip_held)
 {
     volatile uint32_t *regs = (volatile uint32_t *)g_nv2a_memory;
@@ -1452,6 +1457,12 @@ static void nv2a_ack_busy_bits(int flip_held)
             else if (NV2A_ACK[i].offset == NV2A_ACK_PCRTC_INTR_0)
                 mask &= ~NV2A_ACK_PCRTC_INTR_VBLANK;
         }
+        if (g_nv2a_sw_intr_inflight) {
+            if (NV2A_ACK[i].offset == NV2A_ACK_PMC_INTR_0)
+                mask &= ~0x00001000u;               /* PMC: PGRAPH */
+            else if (NV2A_ACK[i].offset == 0x400100u)
+                mask &= ~0x00100000u;               /* PGRAPH_INTR_ERROR */
+        }
         /* Interlocked: the vblank-ack thread and the guest change other
          * bits of the same word meanwhile. */
         if (*r & mask)
