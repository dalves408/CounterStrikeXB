@@ -115,6 +115,40 @@ typedef struct {
     void (*flip)(void);
 } Nv2aBackend;
 
+/* Vertex-program batches, untransformed (optional; see
+ * nv2a_backend_register_program). The back end runs the program itself --
+ * on the GPU, say -- instead of the executor running it on the CPU per vertex.
+ *
+ * inputs holds vertex_count vertices, each popcount(input_mask) float4 rows:
+ * the attributes the program reads, in v0..v15 order, fetched as the CPU path
+ * fetches them (a stream converted to float, or the attribute's current value
+ * when it has no stream). indices is a triangle list into those vertices; strips
+ * already alternate their odd triangles' order, so winding is what the GPU
+ * would cull by. The program's oPos is screen space in logical pixels (scale x,
+ * y by the surface's aa_sx, aa_sy) with w the clip-space w, exactly as
+ * nv2a_vsh_run produces it. Fog: SET_FOG_ENABLE / _MODE / _PARAMS, applied to
+ * oFog.x as the CPU path's fog_factor does. */
+typedef struct {
+    const uint32_t (*program)[4];   /* start slot .. the FINAL instruction */
+    uint32_t     program_count;
+    const float (*constants)[4];    /* c[0..191] */
+    uint32_t     input_mask;
+    const float (*inputs)[4];
+    uint32_t     vertex_count;
+    const uint32_t *indices;
+    uint32_t     index_count;
+    uint32_t     fog_enable, fog_mode;
+    float        fog_param[2];
+} Nv2aProgramDraw;
+
+/* Draw a program batch; b carries state, combiners and stages as for draw()
+ * (vertices NULL, count 0). Return 1 if drawn, 0 to have the executor transform
+ * it on the CPU and call draw() as usual. Only offered for programs that do not
+ * write constants (CXT_WRITE). */
+typedef int (*Nv2aProgramDrawFn)(const Nv2aSurface *s, const Nv2aBatch *b,
+                                 const Nv2aProgramDraw *p);
+void nv2a_backend_register_program(Nv2aProgramDrawFn fn);
+
 /* Register (or, with NULL, remove) the back end. Call before the title starts
  * submitting work; the executor must also be enabled (RECOMP_PB_EXEC). */
 void nv2a_backend_register(const Nv2aBackend *backend);
