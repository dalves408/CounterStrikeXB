 src/input/xinput_device.c | 21 ++++++++-
 src/input/xinput_xbox.h   |  2 +
 src/video/fb_present.c    | 92 +++++++++++++++++++++++++++++++++++----
 src/video/video_player.h  | 15 +++++++
 5 files changed, 177 insertions(+), 11 deletions(-)

