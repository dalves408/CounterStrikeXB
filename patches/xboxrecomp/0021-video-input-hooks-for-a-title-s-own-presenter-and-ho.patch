diff --git a/src/video/fb_present.c b/src/video/fb_present.c
index 5a06253..b2123b0 100644
--- a/src/video/fb_present.c
+++ b/src/video/fb_present.c
@@ -42,6 +42,7 @@
 #include "recomp_exit_hook.h"   /* src/platform */
 #include <stdbool.h>
 #include "pvideo_scanout.h"
+#include "video_player.h"
 #include "../nv2a/nv2a_mmio_hook.h"
 
 extern ptrdiff_t xbox_GetMemoryOffset(void);
@@ -75,15 +76,16 @@ static uint32_t      s_pvideo_regs[0x1000 / 4];
 static uint64_t      s_pvideo_stop_generation;
 
 /* Draw the video overlay over s_rgb: a newly submitted bank if there is one
- * (copied, drawn, then handed back to the title), else the last frame. */
-static void fb_overlay(void)
+ * (copied, drawn, then handed back to the title), else the last frame.
+ * Returns 1 when an overlay frame was drawn. */
+static int fb_overlay_into(uint32_t *dst)
 {
     uint32_t regs[0x1000 / 4];
     uint64_t stop_generation;
     unsigned bank;
     bool presented = false;
 
-    if (!s_rgb || !nv2a_hook_pvideo_snapshot(regs, &stop_generation)) return;
+    if (!dst || !nv2a_hook_pvideo_snapshot(regs, &stop_generation)) return 0;
     if (s_pvideo_stop_generation != stop_generation ||
         (s_pvideo_source &&
          regs[(NV_PVIDEO_SIZE_IN + s_pvideo_bank * 4) / 4] == UINT32_MAX)) {
@@ -113,7 +115,7 @@ static void fb_overlay(void)
         snapshot = (uint8_t *)malloc((size_t)bytes);
         if (!snapshot) continue;
         memcpy(snapshot, (const void *)va, (size_t)bytes);
-        if (!pvideo_scanout(regs, snapshot, (size_t)bytes, s_rgb,
+        if (!pvideo_scanout(regs, snapshot, (size_t)bytes, dst,
                             s_fb_width, s_fb_height, bank)) {
             free(snapshot);
             continue;
@@ -132,8 +134,22 @@ static void fb_overlay(void)
         presented = true;
     }
     if (!presented && s_pvideo_source)
-        pvideo_scanout(s_pvideo_regs, s_pvideo_source, s_pvideo_bytes, s_rgb,
-                       s_fb_width, s_fb_height, s_pvideo_bank);
+        presented = pvideo_scanout(s_pvideo_regs, s_pvideo_source, s_pvideo_bytes, dst,
+                                   s_fb_width, s_fb_height, s_pvideo_bank) != 0;
+    return presented ? 1 : 0;
+}
+
+/* The video overlay drawn into `rgb` (the window's frame size, 32-bit), for a
+ * presenter that shows the overlay itself; 1 when there is one. Same thread
+ * as the presenter (the flip); the window thread no longer draws it then. */
+int xbox_FramebufferComposeOverlay(uint32_t *rgb)
+{
+    return fb_overlay_into(rgb);
+}
+
+static int fb_overlay(void)
+{
+    return fb_overlay_into(s_rgb);
 }
 
 void xbox_FramebufferWindowSet(uint32_t fb_va, uint32_t pitch)
@@ -159,6 +175,33 @@ void xbox_FramebufferWindowSetAA(uint32_t sy)
     s_fb_aa_sy = sy ? sy : 1;
 }
 
+/* ---- hooks for a title's own renderer --------------------------------------
+ *
+ * A project with its own GPU renderer can draw the frame into this window
+ * itself, at the flip and at whatever resolution it renders, instead of the
+ * window copying the guest framebuffer out of memory: it registers a
+ * presenter, which the flip calls in place of the copy (with RECOMP_FB_DUMP
+ * the copy is still made, for the dumps). The window thread then only pumps
+ * messages. The rest serve host menus drawn over the game: a key filter that
+ * sees every key message first, the window handle, the video overlay
+ * composited into the caller's frame, and fullscreen from any thread. */
+static xbox_FramebufferPresenterFn s_presenter;
+static xbox_FramebufferKeyFilterFn s_key_filter;
+static volatile HWND s_fb_hwnd;
+static volatile LONG s_fb_full;        /* borderless fullscreen now */
+#define WM_FB_TOGGLE_FULLSCREEN (WM_APP + 0x46)
+
+void xbox_FramebufferSetPresenter(xbox_FramebufferPresenterFn fn) { s_presenter = fn; }
+void xbox_FramebufferSetKeyFilter(xbox_FramebufferKeyFilterFn fn) { s_key_filter = fn; }
+void *xbox_FramebufferWindowHwnd(void) { return (void *)s_fb_hwnd; }
+int xbox_FramebufferIsFullscreen(void) { return s_fb_full != 0; }
+
+void xbox_FramebufferToggleFullscreen(void)
+{
+    if (s_fb_hwnd)
+        PostMessageA(s_fb_hwnd, WM_FB_TOGGLE_FULLSCREEN, 0, 0);
+}
+
 /* Called by the pushbuffer executor when the title flips. */
 void xbox_FramebufferWindowPresent(uint32_t fb_va, uint32_t pitch)
 {
@@ -170,6 +213,11 @@ void xbox_FramebufferWindowPresent(uint32_t fb_va, uint32_t pitch)
         return;
     if (getenv("RECOMP_FB_VA"))
         return;                       /* pinned: leave the old path alone */
+    if (s_presenter) {
+        s_presenter(fb_va, pitch);
+        if (!getenv("RECOMP_FB_DUMP"))
+            return;                   /* the copy below only feeds the dumps */
+    }
     AcquireSRWLockExclusive(&s_present_lock);
     next = (s_present_idx == 0) ? 1 : 0;
     if (!s_present[next]) {
@@ -268,16 +316,26 @@ static void fb_toggle_fullscreen(HWND h)
                      mi.rcMonitor.right - mi.rcMonitor.left, mi.rcMonitor.bottom - mi.rcMonitor.top,
                      SWP_FRAMECHANGED | SWP_SHOWWINDOW);
         full = 1;
+        InterlockedExchange(&s_fb_full, 1);
     } else {
         SetWindowLongPtrA(h, GWL_STYLE, saved_style);
         SetWindowPos(h, NULL, saved.left, saved.top, saved.right - saved.left,
                      saved.bottom - saved.top, SWP_FRAMECHANGED | SWP_NOZORDER | SWP_SHOWWINDOW);
         full = 0;
+        InterlockedExchange(&s_fb_full, 0);
     }
 }
 
 static LRESULT CALLBACK fb_wndproc(HWND h, UINT m, WPARAM w, LPARAM l)
 {
+    if (m == WM_FB_TOGGLE_FULLSCREEN) {
+        fb_toggle_fullscreen(h);
+        return 0;
+    }
+    /* A host menu over the game sees every key first and may keep it. */
+    if (s_key_filter && (m == WM_KEYDOWN || m == WM_KEYUP || m == WM_SYSKEYDOWN || m == WM_SYSKEYUP)
+        && s_key_filter((void *)h, m, (uintptr_t)w, (intptr_t)l))
+        return 0;
     /* First press only (bit 30: the key was already down), and with Alt held
      * (bit 29) for Enter; neither reaches the key table. */
     if ((m == WM_SYSKEYDOWN && w == VK_RETURN && (l & (1 << 29)) && !(l & (1 << 30)))
@@ -548,6 +606,7 @@ static DWORD WINAPI fb_thread(LPVOID unused)
         InterlockedExchange(&s_fb_running, 0);
         return 0;
     }
+    s_fb_hwnd = hwnd;
     hdc = GetDC(hwnd);
     {
         const char *fs = getenv("RECOMP_FULLSCREEN");
@@ -569,7 +628,7 @@ static DWORD WINAPI fb_thread(LPVOID unused)
 
     fprintf(stderr, "  [FBWIN] framebuffer window open (%ux%u)\n",
             s_fb_width, s_fb_height);
-    if (gpu_present_enabled())
+    if (gpu_present_enabled() && !s_presenter)   /* one swap chain per window: the title's renderer makes its own */
         gpu_present_init(hwnd, s_fb_width, s_fb_height);
 
     while (InterlockedCompareExchange(&s_fb_running, 1, 1)) {
@@ -579,7 +638,20 @@ static DWORD WINAPI fb_thread(LPVOID unused)
             TranslateMessage(&msg);
             DispatchMessageA(&msg);
         }
-        if (s_rgb && fb_copy_presented_frame(s_rgb)) {
+        if (s_presenter) {
+            /* The title's renderer draws into this window at its flips; this
+             * thread only pumps messages (and keeps the dumps' copy). */
+            static int handed_over;
+            if (!handed_over) {
+                handed_over = 1;
+                if (gpu_present_active())
+                    gpu_present_shutdown();
+                fprintf(stderr, "  [FBWIN] the title's renderer presents to this window\n");
+            }
+            if (s_rgb)
+                fb_copy_presented_frame(s_rgb);
+            paced = 0;
+        } else if (s_rgb && fb_copy_presented_frame(s_rgb)) {
             /* A finished frame, published by the flip. Copied into s_rgb so
              * the dump path and GDI see one consistent image even if the
              * next flip lands mid-blit. */
@@ -634,7 +706,9 @@ static DWORD WINAPI fb_thread(LPVOID unused)
                 t0 = now; f0 = f;
             }
         }
-        if (!paced)
+        if (s_presenter)
+            MsgWaitForMultipleObjects(0, NULL, FALSE, 5, QS_ALLINPUT);   /* keys reach the menus promptly */
+        else if (!paced)
             Sleep(16);                  /* D3D11's Present waited for vsync */
     }
 
