-DWORD xbox_InputGetState(DWORD dwPort, XBOX_INPUT_STATE *pState)
+static DWORD input_get_state(DWORD dwPort, XBOX_INPUT_STATE *pState)
 {
     XINPUT_STATE xi_state;
     DWORD result;
@@ -134,6 +134,25 @@ DWORD xbox_InputGetState(DWORD dwPort, XBOX_INPUT_STATE *pState)
     return ERROR_SUCCESS;
 }
 
+/* A host menu over the game (a title's quit prompt or settings page, driven
+ * by controller 1 too) holds port 0: the game keeps running and keeps its
+ * controller, but reads it as neutral, so a press meant for the menu is not
+ * also a jump or a shot. The packet number still moves. */
+static volatile LONG s_hold_port0;
+
+void xbox_InputSetHold(int on)
+{
+    InterlockedExchange(&s_hold_port0, on ? 1 : 0);
+}
+
+DWORD xbox_InputGetState(DWORD dwPort, XBOX_INPUT_STATE *pState)
+{
+    DWORD r = input_get_state(dwPort, pState);
+    if (r == ERROR_SUCCESS && dwPort == 0 && s_hold_port0)
+        memset(&pState->Gamepad, 0, sizeof pState->Gamepad);
+    return r;
+}
+
 DWORD xbox_InputSetState(DWORD dwPort, const XBOX_VIBRATION *pVibration)
 {
     XINPUT_VIBRATION xi_vib;
