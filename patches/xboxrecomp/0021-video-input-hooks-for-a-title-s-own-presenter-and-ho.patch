 void xbox_FramebufferWindowSetTitle(const uint16_t *name, int max_chars);
 void xbox_FramebufferWindowFrameStats(uint32_t draws);
 
+/* A title's own renderer and host menus (Windows window; fb_present.c).
+ * The presenter is called at each flip, on the flip's thread, instead of the
+ * window copying the frame out of guest memory. The key filter sees every
+ * WM_KEY* / WM_SYSKEY* message first; non-zero keeps it from the game.
+ * ComposeOverlay draws the PVIDEO overlay into a 32-bit frame of the
+ * window's frame size and returns 1 when there is one (presenter's thread). */
+typedef void (*xbox_FramebufferPresenterFn)(uint32_t fb_va, uint32_t pitch);
+typedef int (*xbox_FramebufferKeyFilterFn)(void *hwnd, unsigned msg, uintptr_t wparam, intptr_t lparam);
+void  xbox_FramebufferSetPresenter(xbox_FramebufferPresenterFn fn);
+void  xbox_FramebufferSetKeyFilter(xbox_FramebufferKeyFilterFn fn);
+void *xbox_FramebufferWindowHwnd(void);
+int   xbox_FramebufferComposeOverlay(uint32_t *rgb);
+void  xbox_FramebufferToggleFullscreen(void);   /* any thread */
+int   xbox_FramebufferIsFullscreen(void);
+
 #if !defined(_WIN32)
 /* POSIX hosts: the framebuffer window needs the process main thread (AppKit
  * on macOS), so a title that wants it calls this from main() with its boot
-- 
