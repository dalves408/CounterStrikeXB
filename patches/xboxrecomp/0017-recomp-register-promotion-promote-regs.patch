  * ================================================================ */
 
 #ifdef RECOMP_GENERATED_CODE
+/* Register promotion (RECOMP_REG_PROMOTE). The architectural registers are
+ * thread-local globals, so every eax/esi/esp access in a translated function
+ * was a memory access -- and with guest memory reached through volatile
+ * pointers, the host compiler also reloaded the thread-local block after
+ * every guest store. Promoted, each translated function works on locals
+ * (l_eax ...), loaded on entry (RECOMP_REGS_DECL); the translator writes them
+ * back to the globals immediately before every transfer out of the function
+ * -- each call, indirect call, tail call and return (RECOMP_REGS_SPILL) -- and
+ * reads them back right after each call (RECOMP_REGS_FILL). Everything outside
+ * a translated function (kernel bridges, interrupts at their safe points, the
+ * ICALL failure paths, the debugger) still sees the globals, current at every
+ * point where it can run. Off, the three macros are no-ops and eax is g_eax
+ * as before, so the same generated source builds either way. */
+#ifdef RECOMP_REG_PROMOTE
+#define eax l_eax
+#define ecx l_ecx
+#define edx l_edx
+#define esp l_esp
+#define ebx l_ebx
+#define esi l_esi
+#define edi l_edi
+#define RECOMP_REGS_DECL \
+    uint32_t l_eax = g_eax, l_ecx = g_ecx, l_edx = g_edx, l_ebx = g_ebx, \
+             l_esi = g_esi, l_edi = g_edi, l_esp = g_esp
+#define RECOMP_REGS_SPILL \
+    (g_eax = l_eax, g_ecx = l_ecx, g_edx = l_edx, g_ebx = l_ebx, \
+     g_esi = l_esi, g_edi = l_edi, g_esp = l_esp)
+#define RECOMP_REGS_FILL \
+    (l_eax = g_eax, l_ecx = g_ecx, l_edx = g_edx, l_ebx = g_ebx, \
+     l_esi = g_esi, l_edi = g_edi, l_esp = g_esp)
+#else
 #define eax g_eax
 #define ecx g_ecx
 #define edx g_edx
@@ -1545,6 +1576,12 @@ void xbox_GuestCpuPreempt(uint32_t va);
 #define ebx g_ebx
 #define esi g_esi
 #define edi g_edi
+#ifndef RECOMP_REGS_DECL
+#define RECOMP_REGS_DECL  (void)0
+#define RECOMP_REGS_SPILL (void)0
+#define RECOMP_REGS_FILL  (void)0
+#endif
+#endif
 
