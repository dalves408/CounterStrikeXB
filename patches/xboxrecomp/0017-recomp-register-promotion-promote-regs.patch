diff --git a/tools/recomp/test_promote_regs.py b/tools/recomp/test_promote_regs.py
new file mode 100644
index 0000000..9c6ed16
--- /dev/null
+++ b/tools/recomp/test_promote_regs.py
@@ -0,0 +1,52 @@
+"""Register promotion (--promote-regs): every transfer out of a translated
+function is bracketed by write-back/read-back, at the right place.
+
+The write-back has to sit between the return-address push and the call (the
+callee reads esp), a call under a bare `if` must stay one statement, comments
+are left alone, and the entry load comes after the opening brace and any entry
+hook.
+"""
+from tools.recomp.translator import _promote_regs
+
+
+def test_direct_call_bracketed_after_the_push():
+    out = _promote_regs(["{", "    PUSH32(esp, 0x10u); RECOMP_ABI_CALL(0x20u, sub_00000020); /* call */"])
+    assert out[1] == "    RECOMP_REGS_DECL;"
+    assert out[2] == ("    PUSH32(esp, 0x10u); { RECOMP_REGS_SPILL; "
+                      "RECOMP_ABI_CALL(0x20u, sub_00000020); RECOMP_REGS_FILL; } /* call */")
+
+
+def test_return_writes_back_first():
+    out = _promote_regs(["{", "    esp += 4; return; /* ret */"])
+    assert out[2] == "    esp += 4; { RECOMP_REGS_SPILL; return; } /* ret */"
+
+
+def test_tail_call_and_fallthrough():
+    out = _promote_regs(["{", "    g_seh_ebp = ebp; sub_0022C3D4(); return; /* tail jmp */"])
+    assert out[2] == ("    g_seh_ebp = ebp; { RECOMP_REGS_SPILL; sub_0022C3D4(); RECOMP_REGS_FILL; }"
+                      " { RECOMP_REGS_SPILL; return; } /* tail jmp */")
+
+
+def test_guarded_indirect_call_brackets_each_arm():
+    line = ("    { uint32_t _icall_target = MEM32(eax); PUSH32(esp, 0x5u); if (_icall_target == 0x9u)"
+            " { RECOMP_ICALL_GUARD_HIT(); RECOMP_ABI_CALL(0x9u, sub_00000009); } else"
+            " { RECOMP_ICALL_GUARD_MISS(); RECOMP_ICALL_SAFE_AT(_icall_target, _icall_esp, 0x4u); } }")
+    out = _promote_regs(["{", line])[2]
+    assert out.count("RECOMP_REGS_SPILL;") == 2 and out.count("RECOMP_REGS_FILL;") == 2
+    assert "{ RECOMP_REGS_SPILL; RECOMP_ICALL_SAFE_AT(_icall_target, _icall_esp, 0x4u); RECOMP_REGS_FILL; }" in out
+
+
+def test_comments_and_helpers_untouched():
+    src = ["{", "    /* nothing here return; */", "    fp_pop(); /* return; in a comment */"]
+    out = _promote_regs(src)
+    assert out[2:] == src[1:]
+
+
+def test_entry_load_after_the_hook():
+    out = _promote_regs(["{", "    extern void sub_00010000_enter(void);", "    sub_00010000_enter();", "    eax = 1;"])
+    assert out[3] == "    RECOMP_REGS_DECL;"
+
+
+def test_longjmp_writes_back_before_the_statement():
+    out = _promote_regs(["{", "    if (!recomp_guest_longjmp(MEM32(esp), MEM32(esp + 4))) { PUSH32(esp, 0x1u); sub_00000002(); }"])
+    assert out[2].startswith("    RECOMP_REGS_SPILL; if (!recomp_guest_longjmp(")
diff --git a/tools/recomp/translator.py b/tools/recomp/translator.py
index 21600d3..f3d5c6f 100644
--- a/tools/recomp/translator.py
+++ b/tools/recomp/translator.py
@@ -220,6 +220,120 @@ def _is_safe_icall(line):
         "RECOMP_ICALL_SAFE_CC", "RECOMP_ICALL_SAFE_AT_CC"))
 
 
+# Register promotion (see RECOMP_REG_PROMOTE in templates/runtime/recomp_types.h).
+# Every point where control leaves a translated function gets the registers
+# written back to the globals immediately before it (RECOMP_REGS_SPILL) and,
+# where control comes back, read back right after (RECOMP_REGS_FILL). The
+# transfers are exactly these: the call macros (direct calls through
+# RECOMP_ABI_CALL, indirect calls, indirect tail jumps), direct tail and
+# fall-through calls `sub_XXXXXXXX();`, a guest longjmp, and `return;`. The
+# write-back goes right before the call -- not before the statement -- because
+# the statement pushes the return address first. Each insertion is braced so a
+# call under a bare `if (...)` stays one statement. Without the define the
+# macros are no-ops and the output is equivalent to the unpromoted code.
+PROMOTE_REGS = False      # set by __main__ from --promote-regs
+_PROMOTE_CALL_MACROS = ("RECOMP_ABI_CALL(", "RECOMP_ICALL_SAFE_AT_CC(",
+                        "RECOMP_ICALL_SAFE_AT(", "RECOMP_ICALL_SAFE_CC(",
+                        "RECOMP_ICALL_SAFE(", "RECOMP_ICALL(", "RECOMP_ITAIL(")
+_PROMOTE_DIRECT = __import__("re").compile(r"\bsub_[0-9A-F]{8}\(\)\s*;")
+_PROMOTE_RETURN = __import__("re").compile(r"(?<![\w])return\s*;")
+
+
+def _promote_split_comment(line):
+    """Code part and trailing comment of a generated line ("/*" never occurs
+    inside a string literal in generated code)."""
+    i = line.find("/*")
+    return (line, "") if i < 0 else (line[:i], line[i:])
+
+
+def _promote_call_end(code, open_idx):
+    """Index just past the ';' closing the call whose '(' is at open_idx."""
+    depth = 0
+    for k in range(open_idx, len(code)):
+        ch = code[k]
+        if ch == "(":
+            depth += 1
+        elif ch == ")":
+            depth -= 1
+            if depth == 0:
+                rest = code[k + 1:]
+                semi = len(rest) - len(rest.lstrip())
+                if rest[semi:semi + 1] == ";":
+                    return k + 1 + semi + 1
+                return None
+    return None
+
+
+def _promote_line(code):
+    out = []
+    i = 0
+    n = len(code)
+    while i < n:
+        # Earliest transfer at or after i.
+        best = None
+        for m in _PROMOTE_CALL_MACROS:
+            j = code.find(m, i)
+            # A longer macro name ending in this one (RECOMP_ICALL_SAFE_AT vs
+            # RECOMP_ICALL) must not be split: require a non-identifier before.
+            while j >= 0 and j > 0 and (code[j - 1].isalnum() or code[j - 1] == "_"):
+                j = code.find(m, j + 1)
+            if j >= 0 and (best is None or j < best[0]):
+                best = (j, "macro", m)
+        dm = _PROMOTE_DIRECT.search(code, i)
+        if dm and (best is None or dm.start() < best[0]):
+            best = (dm.start(), "direct", None)
+        rm = _PROMOTE_RETURN.search(code, i)
+        if rm and (best is None or rm.start() < best[0]):
+            best = (rm.start(), "return", None)
+        if best is None:
+            out.append(code[i:])
+            break
+        j, kind, m = best
+        out.append(code[i:j])
+        if kind == "return":
+            out.append("{ RECOMP_REGS_SPILL; " + rm.group(0) + " }")
+            i = rm.end()
+        elif kind == "direct":
+            out.append("{ RECOMP_REGS_SPILL; " + dm.group(0) + " RECOMP_REGS_FILL; }")
+            i = dm.end()
+        else:
+            end = _promote_call_end(code, j + len(m) - 1)
+            if end is None:            # not a statement-level call: leave it
+                out.append(code[j:j + len(m)])
+                i = j + len(m)
+                continue
+            out.append("{ RECOMP_REGS_SPILL; " + code[j:end] + " RECOMP_REGS_FILL; }")
+            i = end
+    return "".join(out)
+
+
+def _promote_regs(lines):
+    result = []
+    for line in lines:
+        s = line.lstrip()
+        if s.startswith("#") or s.startswith("/*") or s.startswith("*"):
+            result.append(line)
+            continue
+        code, comment = _promote_split_comment(line)
+        if "recomp_guest_longjmp(" in code:
+            # A guest longjmp that succeeds never comes back; its fallback is a
+            # direct call, promoted below like any other.
+            ind = code[:len(code) - len(code.lstrip())]
+            code = ind + "RECOMP_REGS_SPILL; " + code.lstrip()
+        result.append(_promote_line(code) + comment)
+    # Load the registers on entry: after the opening brace and any entry hook.
+    for k, line in enumerate(result):
+        if line == "{":
+            at = k + 1
+            while at < len(result) and (result[at].startswith("    extern void sub_")
+                                        or result[at].rstrip().endswith("_enter();")
+                                        or "_enter(); RECOMP_REGS_FILL; }" in result[at]):
+                at += 1
+            result.insert(at, "    RECOMP_REGS_DECL;")
+            break
+    return result
+
+
 def _fixup_icall_esp_save(lines):
     """
     Post-process generated C lines to insert _icall_esp save points.
@@ -317,7 +431,10 @@ def _fixup_icall_esp_save(lines):
         if i in insert_before:
             # Determine indentation from the current line
             indent = line[:len(line) - len(line.lstrip())]
-            result.append(f"{indent}{{ uint32_t _icall_esp = g_esp;")
+            # Under register promotion the current esp is the function's local
+            # (esp); otherwise esp is g_esp and the text stays as it was.
+            src = "esp" if PROMOTE_REGS else "g_esp"
+            result.append(f"{indent}{{ uint32_t _icall_esp = {src};")
         result.append(line)
         if _is_safe_icall(line):
             indent = line[:len(line) - len(line.lstrip())]
@@ -3456,6 +3573,11 @@ class FunctionTranslator:
         # We insert "uint32_t _icall_esp = g_esp;" before the first arg push.
         lines = _fixup_icall_esp_save(lines)
 
+        # Register promotion: write-back/read-back around every transfer, and
+        # the entry load (inert unless RECOMP_REG_PROMOTE is defined).
+        if PROMOTE_REGS:
+            lines = _promote_regs(lines)
+
         # Validate: comment out goto targets that reference missing labels
         # (dead code after unconditional jumps may reference non-existent labels)
         import re
