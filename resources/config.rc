#include <winver.h>

1 ICON "cs.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,9,3,0
 PRODUCTVERSION 0,9,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "dalves408/CounterStrikeXB"
            VALUE "FileDescription", "Counter-Strike recompilation settings"
            VALUE "FileVersion", "0.9.3.0"
            VALUE "InternalName", "config"
            VALUE "LegalCopyright", "Fan-made recompilation. Game assets are not included."
            VALUE "OriginalFilename", "config.exe"
            VALUE "ProductName", "Counter-Strike"
            VALUE "ProductVersion", "0.9.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
